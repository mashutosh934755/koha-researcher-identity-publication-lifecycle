/* BEGIN OPAC SOURCE AUTHOR NAMES V7 CSS */

.ri-source-author-names {
    margin: 12px 0;
    padding: 12px;
    border: 1px solid #d9e2ec;
    border-radius: 10px;
    background: #f8fafc;
}

.ri-source-author-heading {
    margin-bottom: 9px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #334155;
}

.ri-source-author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 7px;
}

.ri-source-author-icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 800;
    color: #ffffff;
}

.ri-source-author-scopus .ri-source-author-icon {
    background: #e9711c;
}

.ri-source-author-wos .ri-source-author-icon {
    background: #2563a8;
}

.ri-source-author-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.ri-source-author-details strong {
    font-size: 0.76rem;
    color: #475569;
}

.ri-source-author-details span {
    overflow-wrap: anywhere;
    font-size: 0.91rem;
    color: #0f172a;
}

/* END OPAC SOURCE AUTHOR NAMES V7 CSS */


.ri-source-author-profile-link {
    color: #0b57a4;
    font-size: 0.91rem;
    font-weight: 600;
    text-decoration: none;
}

.ri-source-author-profile-link:hover,
.ri-source-author-profile-link:focus {
    color: #073b70;
    text-decoration: underline;
}


/* BEGIN HIDE WOS CITATIONS V1 */

/*
 * WoS publication/source badges remain visible.
 * Only WoS citation values/cards are hidden.
 */
.ri-source-metric-wos,
[data-source-metric="wos-citations"],
[data-metric="wos-citations"],
.wos-citations,
.wos-citation-card,
.ri-wos-citations {
    display: none !important;
}

/* END HIDE WOS CITATIONS V1 */


/* BEGIN PROFILE DISPLAY NAME STYLE V1 */

.ri-profile-display-note {
    margin: 0 0 14px;
    color: #64748b;
    font-size: 0.92rem;
}

.ri-profile-display-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
}

.ri-profile-display-row {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 14px;
    border: 1px solid #dbe3ec;
    border-radius: 10px;
    background: #ffffff;
}

.ri-profile-display-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #ffffff;
    font-weight: 800;
}

.ri-profile-display-scopus
.ri-profile-display-icon {
    background: #e9711c;
}

.ri-profile-display-wos
.ri-profile-display-icon {
    background: #2563a8;
}

.ri-profile-display-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.ri-profile-display-content strong {
    color: #475569;
    font-size: 0.78rem;
}

.ri-profile-display-content a,
.ri-profile-display-content span {
    color: #0f172a;
    font-size: 1rem;
    font-weight: 700;
    overflow-wrap: anywhere;
}

/* END PROFILE DISPLAY NAME STYLE V1 */

</style>
</head>

[% INCLUDE 'bodytag.inc' bodyid='opac-researcher-profile' bodyclass='scrollto' %]
[% INCLUDE 'masthead.inc' %]

<div class="main">
  <div class="container-fluid">
    <div class="pub-wrap">

      [% IF error %]
        <div class="pub-alert">[% error | html %]</div>
        <div class="pub-actions"><a href="/cgi-bin/koha/opac-researcher-search.pl">Search Researchers</a></div>

      [% ELSIF !has_profile %]
        <div class="pub-empty">Research profile is not complete yet.</div>
        <div class="pub-actions">
          <a href="/cgi-bin/koha/opac-researcher-search.pl">Search Researchers</a>
          [% IF can_edit %]<a href="/cgi-bin/koha/opac-custom-profile.pl">Complete Profile</a>[% END %]
        </div>

      [% ELSE %]

      <div class="pub-top">
        [% IF has_photo %]
          <img class="pub-photo" src="/cgi-bin/koha/opac-researcher-photo.pl?id=[% profile.borrowernumber | html %]&t=[% now | html %]" alt="Profile photo">
        [% ELSE %]
          <div class="pub-no-photo">No Photo</div>
        [% END %]

        <div>
          <h1 class="pub-name">[% profile.preferred_name | html %]</h1>
          <div class="pub-job">[% profile.job_title | html %]</div>
          <div class="pub-aff">[% profile.main_affiliation | html %]</div>

          <div class="pub-status-row">
            [% IF profile.is_verified %]
              <span class="pub-status-badge pub-status-verified">
                Verified Research Profile
              </span>
            [% ELSE %]
              <span class="pub-status-badge pub-status-pending">
                [% profile.verification_label | html %]
              </span>
            [% END %]

            [% IF profile.is_current %]
              <span class="pub-status-badge pub-status-active">
                Current Institutional Researcher
              </span>
            [% ELSIF profile.is_former %]
              <span class="pub-status-badge pub-status-former">
                Former Institutional Researcher
              </span>
            [% ELSE %]
              <span class="pub-status-badge pub-status-inactive">
                [% profile.employment_label | html %]
              </span>
            [% END %]
          </div>

          <div class="pub-actions">
            <a class="secondary" href="/cgi-bin/koha/opac-researcher-search.pl">Search Researchers</a>
            [% IF profile.website_url %]
              <a class="secondary" href="[% profile.website_url | html %]" target="_blank" rel="noopener">Visit Website</a>
            [% END %]
            [% IF can_edit %]
              <a href="/cgi-bin/koha/opac-custom-profile.pl">Edit Profile</a>
            [% END %]
          </div>
        </div>
      </div>

      <div class="pub-grid">

        <div class="pub-card full">
          <h2>Biography</h2>
          <div class="pub-text">[% profile.biography | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Person Basic Information</h2>
          <div class="pub-line"><span class="pub-label">Full Name:</span> [% profile.preferred_name | html %]</div>
          <div class="pub-line"><span class="pub-label">First Name:</span> [% profile.first_name | html %]</div>
          <div class="pub-line"><span class="pub-label">Last Name:</span> [% profile.last_name | html %]</div>
          <div class="pub-line"><span class="pub-label">Official Name:</span> [% profile.official_name | html %]</div>
          <div class="pub-line"><span class="pub-label">Alternative Name:</span> [% profile.alternative_name | html %]</div>
          <div class="pub-line"><span class="pub-label">Gender:</span> [% profile.gender | html %]</div>
          <div class="pub-line"><span class="pub-label">User Type:</span> [% profile.user_type | html %]</div>
          <div class="pub-line">
            <span class="pub-label">Verification Status:</span>
            [% profile.verification_label | html %]
          </div>
          <div class="pub-line">
            <span class="pub-label">Researcher Status:</span>
            [% profile.employment_label | html %]
          </div>
        </div>

        <div class="pub-card">
          <h2>Professional Details</h2>
          <div class="pub-line"><span class="pub-label">Job Title:</span> [% profile.job_title | html %]</div>
          <div class="pub-line"><span class="pub-label">Affiliation:</span> [% profile.main_affiliation | html %]</div>
          <div class="pub-line"><span class="pub-label">Department / Group:</span> [% profile.working_group | html %]</div>
          <div class="pub-line"><span class="pub-label">Email:</span> [% profile.email | html %]</div>
          <div class="pub-line"><span class="pub-label">Employee ID:</span> [% profile.employee_id | html %]</div>
          <div class="pub-line"><span class="pub-label">Enrollment ID:</span> [% profile.enrollment_id | html %]</div>
        </div>

        
        <!-- BEGIN SOURCE PROFILE DISPLAY NAMES V1 -->
        [% IF source_profile_display_names
           && source_profile_display_names.size %]
            <div class="pub-card ri-profile-display-names">
                <h2>Scholarly Profile Display Names</h2>

                <p class="ri-profile-display-note">
                    Profile names below are obtained from the
                    connected scholarly source APIs. The API
                    spelling, punctuation and name order are
                    displayed without manual modification.
                </p>

                <div class="ri-profile-display-grid">
                    [% FOREACH source_identity
                               IN source_profile_display_names %]
                        [% IF source_identity.profile_display_name %]
                            <div class="ri-profile-display-row
                                [% IF source_identity.source_name
                                      == 'scopus' %]
                                    ri-profile-display-scopus
                                [% ELSE %]
                                    ri-profile-display-wos
                                [% END %]">

                                <span class="ri-profile-display-icon"
                                      aria-hidden="true">
                                    [% IF source_identity.source_name
                                          == 'scopus' %]
                                        S
                                    [% ELSE %]
                                        W
                                    [% END %]
                                </span>

                                <span class="ri-profile-display-content">
                                    <strong>
                                        [% IF source_identity.source_name
                                              == 'scopus' %]
                                            Scopus Profile Display Name
                                        [% ELSE %]
                                            Web of Science Profile
                                            Display Name
                                        [% END %]
                                    </strong>

                                    [% IF source_identity.profile_url %]
                                        <a
                                          href="[% source_identity.profile_url | html %]"
                                          target="_blank"
                                          rel="noopener noreferrer">
                                            [% source_identity.profile_display_name | html %]
                                        </a>
                                    [% ELSE %]
                                        <span>
                                            [% source_identity.profile_display_name | html %]
                                        </span>
                                    [% END %]
                                </span>
                            </div>
                        [% END %]
                    [% END %]
                </div>
            </div>
        [% END %]
        <!-- END SOURCE PROFILE DISPLAY NAMES V1 -->


        <!-- BEGIN ALL API AUTHOR NAME VARIANTS V11 -->
        [% IF profile.has_source_name_groups %]
          
        <!-- Old publication-indexed author-name variants section removed.
             Source profile display names are shown once above. -->


          <style>
            .ri-api-author-name-card {
              overflow: hidden;
            }

            .ri-api-name-intro {
              margin: -2px 0 16px;
              color: #52606d;
              font-size: 0.92rem;
              line-height: 1.55;
            }

            .ri-api-name-groups {
              display: grid;
              grid-template-columns:
                repeat(auto-fit, minmax(280px, 1fr));
              gap: 16px;
            }

            .ri-api-name-group {
              border: 1px solid #d9e2ec;
              border-radius: 12px;
              background: #ffffff;
              overflow: hidden;
            }

            .ri-api-name-source-header {
              display: flex;
              align-items: center;
              gap: 10px;
              padding: 13px 14px;
              border-bottom: 1px solid #e5e7eb;
              background: #f8fafc;
            }

            .ri-api-name-source-icon {
              display: inline-flex;
              width: 32px;
              height: 32px;
              align-items: center;
              justify-content: center;
              flex: 0 0 32px;
              border-radius: 50%;
              color: #ffffff;
              font-size: 0.84rem;
              font-weight: 800;
            }

            .ri-api-name-group-scopus
            .ri-api-name-source-icon {
              background: #e9711c;
            }

            .ri-api-name-group-wos
            .ri-api-name-source-icon {
              background: #2563a8;
            }

            .ri-api-name-source-header strong {
              display: block;
              color: #172b4d;
              font-size: 0.97rem;
            }

            .ri-api-name-source-count {
              margin-top: 2px;
              color: #64748b;
              font-size: 0.78rem;
            }

            .ri-api-name-profile-link {
              margin-left: auto;
              color: #0b57a4;
              font-size: 0.82rem;
              font-weight: 650;
              text-decoration: none;
              white-space: nowrap;
            }

            .ri-api-name-profile-link:hover,
            .ri-api-name-profile-link:focus {
              text-decoration: underline;
            }

            .ri-api-name-list {
              padding: 8px 14px 12px;
            }

            .ri-api-name-item {
              padding: 10px 0;
              border-bottom: 1px solid #edf2f7;
            }

            .ri-api-name-item:last-child {
              border-bottom: 0;
            }

            .ri-api-name-value {
              overflow-wrap: anywhere;
              color: #0f172a;
              font-size: 0.96rem;
              font-weight: 650;
              line-height: 1.4;
            }

            .ri-api-name-primary {
              display: inline-block;
              margin-left: 7px;
              padding: 2px 7px;
              border-radius: 999px;
              background: #dcfce7;
              color: #166534;
              font-size: 0.67rem;
              font-weight: 750;
              vertical-align: middle;
            }

            .ri-api-name-meta {
              margin-top: 3px;
              color: #64748b;
              font-size: 0.75rem;
              overflow-wrap: anywhere;
            }

            @media (max-width: 600px) {
              .ri-api-name-source-header {
                align-items: flex-start;
                flex-wrap: wrap;
              }

              .ri-api-name-profile-link {
                width: 100%;
                margin-left: 42px;
              }
            }
          </style>
        [% END %]
        <!-- END ALL API AUTHOR NAME VARIANTS V11 -->

        <div class="pub-card">
          <h2>Researcher Identifiers</h2>
          <div class="pub-line"><span class="pub-label">ORCID:</span> [% profile.orcid | html %]</div>
          <div class="pub-line"><span class="pub-label">Scopus Author ID:</span> [% profile.scopus_author_id | html %]</div>
          <div class="pub-line"><span class="pub-label">Web of Science ID:</span> [% profile.researcher_id | html %]</div>

          [% IF profile.google_scholar_profile %]
            <div class="pub-line"><span class="pub-label">Google Scholar:</span>
              <a class="pub-link" href="[% profile.google_scholar_profile | html %]" target="_blank" rel="noopener">Open Profile</a>
            </div>
          [% END %]

          <div class="pub-line"><span class="pub-label">Vidwan ID:</span> [% profile.vidwan_id | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Country & Language</h2>
          <div class="pub-line"><span class="pub-label">Country:</span> [% profile.country | html %]</div>
          <div class="pub-line"><span class="pub-label">Language:</span></div>
          <div class="pub-text">[% profile.knows_language | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Research Interests / Keywords</h2>
          <div class="pub-text">[% profile.research_interests | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Fields of Science and Technology (OECD)</h2>
          <div class="pub-text">[% profile.oecd_areas | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Affiliation</h2>
          <div class="pub-line"><span class="pub-label">Role:</span> [% profile.affiliation_role | html %]</div>
          <div class="pub-line"><span class="pub-label">Organisation:</span> [% profile.affiliation_organisation | html %]</div>
          <div class="pub-line"><span class="pub-label">Start:</span> [% profile.affiliation_start | html %]</div>
          <div class="pub-line"><span class="pub-label">End:</span> [% profile.affiliation_end | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Education</h2>
          <div class="pub-line"><span class="pub-label">Degree:</span> [% profile.education_role | html %]</div>
          <div class="pub-line"><span class="pub-label">Organisation:</span> [% profile.education_organisation | html %]</div>
          <div class="pub-line"><span class="pub-label">Start:</span> [% profile.education_start | html %]</div>
          <div class="pub-line"><span class="pub-label">End:</span> [% profile.education_end | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Eperson Policy</h2>
          <div class="pub-text">[% profile.eperson_policy | html %]</div>
        </div>

        <div class="pub-card">
          <h2>Group Policy</h2>
          <div class="pub-text">[% profile.group_policy | html %]</div>
        </div>
        <div class="pub-card full pub-crossref-section">
          <h2>
            Crossref Verified Publications
            ([% crossref_verified_count | html %])
          </h2>

          <div class="pub-count-note">
            These records are verified from stored Crossref metadata.
            Crossref data does not automatically change publication DOI
            or authorship.
            [% IF crossref_last_synced %]
              Last verified:
              [% crossref_last_synced | html %]
            [% END %]
          </div>

          [% IF crossref_verified_count == 0 %]
            <div class="pub-empty">
              No locally verified Crossref publication metadata
              is available for this researcher.
            </div>
          [% ELSE %]
            <div class="pub-list">
              [% FOREACH p IN crossref_verified_pubs %]
                <div class="pub-item">
                  <div class="pub-item-title">
                    [% IF p.crossref_url %]
                      <a
                        class="pub-link"
                        href="[% p.crossref_url | html %]"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        [% p.title | html %]
                      </a>
                    [% ELSE %]
                      [% p.title | html %]
                    [% END %]
                  </div>

                  <div class="pub-meta">
                    <span class="pub-badge pub-crossref-badge">
                      Crossref Verified
                    </span>

                    [% IF p.source %]
                      [% p.source | html %]
                    [% END %]

                    [% IF p.display_year %]
                      • [% p.display_year | html %]
                    [% END %]

                    [% IF p.document_type %]
                      • [% p.document_type | html %]
                    [% END %]

                    [% IF p.citation_count != '' %]
                      • Crossref citations:
                      [% p.citation_count | html %]
                    [% END %]

                    [% IF p.last_synced_at %]
                      • Verified:
                      [% p.last_synced_at | html %]
                    [% END %]
                  </div>

                  [% IF p.doi %]
                    <div class="pub-meta">
                      DOI:
                      <a
                        class="pub-link"
                        href="[% p.doi_url | html %]"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        [% p.doi | html %]
                      </a>
                    </div>

                    <div class="pub-metrics">
                      <div
                        class="altmetric-embed"
                        data-badge-type="donut"
                        data-doi="[% p.doi | html %]"
                        data-hide-no-mentions="false"
                      ></div>

                      <span class="pub-metric-label">
                        Dimensions citations
                      </span>

                      <span
                        class="__dimensions_badge_embed__"
                        data-doi="[% p.doi | html %]"
                        data-style="small_circle"
                        data-hide-zero-citations="false"
                      ></span>
                    </div>
                  [% END %]
                </div>
              [% END %]
            </div>
          [% END %]
        </div>



        <div class="pub-card full">
          <h2>Scopus Indexed Publications ([% scopus_count | html %])</h2>
          <div class="pub-count-note">Available records are loaded page by page from the Scopus Author ID.</div>

          [% IF scopus_error %]
            <div class="pub-empty">Scopus data could not be loaded: [% scopus_error | html %]</div>
          [% ELSIF scopus_count == 0 %]
            <div class="pub-empty">No publication data was found for this Scopus Author ID.</div>
          [% ELSE %]
            <div class="pub-list">
              [% FOREACH p IN scopus_pubs %]
                <div class="pub-item">
                  <div class="pub-item-title">
                    [% IF p.url %]
                      <a class="pub-link" href="[% p.url | html %]" target="_blank" rel="noopener">[% p.title | html %]</a>
                    [% ELSE %]
                      [% p.title | html %]
                    [% END %]
                  </div>
                  <div class="pub-meta">
                    <span class="pub-badge">Scopus</span>
                    [% p.source | html %]
                    [% IF p.date %] • [% p.date | html %][% END %]
                    [% IF p.doi %] • DOI: [% p.doi | html %][% END %]
                    [% IF p.cites %] • Scopus Citations: [% p.cites | html %][% END %]
                  </div>
                  [% IF p.doi %]
                    <div class="pub-metrics">
                      <span class="pub-metric-label">Altmetric attention</span>
                      <div class="altmetric-embed" data-badge-type="donut" data-doi="[% p.doi | html %]" data-hide-no-mentions="false"></div>
                      <span class="pub-metric-label">Dimensions citations</span>
                      <span class="__dimensions_badge_embed__" data-doi="[% p.doi | html %]" data-style="small_circle" data-hide-zero-citations="false"></span>
                      <span class="pub-metric-label">PlumX Metrics</span>
                      <a href="https://plu.mx/plum/a/?doi=[% p.doi | html %]" class="plumx-plum-print-popup pub-plumx-widget" data-popup="right" data-size="large" data-hide-when-empty="false" data-detail-same-page="false" target="_blank" rel="noopener noreferrer"></a>
                    </div>
                  [% END %]
                </div>
              [% END %]
            </div>
          [% END %]
        </div>

        <div class="pub-card full">
          <h2>Web of Science Indexed Publications ([% wos_count | html %])</h2>
          <div class="pub-count-note">Available records are loaded page by page from the Web of Science ResearcherID / ORCID.</div>

          [% IF wos_error %]
            <div class="pub-empty">Web of Science data could not be loaded: [% wos_error | html %]</div>
          [% ELSIF wos_count == 0 %]
            <div class="pub-empty">No Web of Science publication data was found for this ResearcherID / ORCID.</div>
          [% ELSE %]
            <div class="pub-list">
              [% FOREACH p IN wos_pubs %]
                <div class="pub-item">
                  <div class="pub-item-title">
                    [% IF p.url %]
                      <a class="pub-link" href="[% p.url | html %]" target="_blank" rel="noopener">[% p.title | html %]</a>
                    [% ELSE %]
                      [% p.title | html %]
                    [% END %]
                  </div>
                  <div class="pub-meta">
                    <span class="pub-badge">Web of Science</span>
                    [% p.source | html %]
                    [% IF p.date %] • [% p.date | html %][% END %]
                    [% IF p.doi %] • DOI: [% p.doi | html %][% END %]
                    [% IF p.cites %] • WOS Citations: [% p.cites | html %][% END %]
                  </div>
                  [% IF p.doi %]
                    <div class="pub-metrics">
                      <span class="pub-metric-label">Altmetric attention</span>
                      <div class="altmetric-embed" data-badge-type="donut" data-doi="[% p.doi | html %]" data-hide-no-mentions="false"></div>
                      <span class="pub-metric-label">Dimensions citations</span>
                      <span class="__dimensions_badge_embed__" data-doi="[% p.doi | html %]" data-style="small_circle" data-hide-zero-citations="false"></span>
                      <span class="pub-metric-label">PlumX Metrics</span>
                      <a href="https://plu.mx/plum/a/?doi=[% p.doi | html %]" class="plumx-plum-print-popup pub-plumx-widget" data-popup="right" data-size="large" data-hide-when-empty="false" data-detail-same-page="false" target="_blank" rel="noopener noreferrer"></a>
                    </div>
                  [% END %]
                </div>
              [% END %]
            </div>
          [% END %]
        </div>

      </div>
      [% END %]

    </div>
  </div>
</div>


<!-- BEGIN OPAC UNIFIED RESEARCH INTELLIGENCE -->

<style>
.ri-unified-shell{
    max-width:1150px;
    margin:24px auto;
    padding:0 12px;
    color:#0f172a;
}

.ri-unified-card{
    background:#fff;
    border:1px solid #dbe3ec;
    border-radius:18px;
    box-shadow:0 14px 38px rgba(15,23,42,.08);
    padding:24px;
}

.ri-heading-row{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:18px;
    flex-wrap:wrap;
    margin-bottom:18px;
}

.ri-heading{
    margin:0 0 6px;
    font-size:27px;
    font-weight:900;
    color:#071b3a !important;
}

.ri-subtitle{
    margin:0;
    color:#64748b !important;
}

.ri-kpis{
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:12px;
    margin:18px 0 22px;
}

.ri-kpi{
    border:1px solid #dbe3ec;
    border-radius:14px;
    padding:16px;
    background:#f8fafc;
}

.ri-kpi-value{
    display:block;
    font-size:27px;
    line-height:1;
    font-weight:900;
    color:#071b3a !important;
    margin-bottom:7px;
}

.ri-kpi-label{
    display:block;
    font-size:13px;
    font-weight:800;
    color:#64748b !important;
}

.ri-tools{
    display:grid;
    grid-template-columns:minmax(220px,2fr) repeat(3,minmax(135px,1fr));
    gap:10px;
    margin-bottom:18px;
}

.ri-tools input,
.ri-tools select{
    width:100%;
    border:1px solid #cbd5e1;
    border-radius:10px;
    padding:11px 12px;
    background:#fff;
    color:#0f172a;
}

.ri-result-note{
    margin:8px 0 14px;
    color:#64748b !important;
    font-weight:700;
}

.ri-publication-list{
    display:grid;
    gap:13px;
}

.ri-publication{
    border:1px solid #dbe3ec;
    border-radius:14px;
    padding:17px;
    background:#fff;
}

.ri-publication-title{
    margin:0 0 8px;
    font-size:17px;
    line-height:1.45;
    font-weight:900;
    color:#071b3a !important;
}

.ri-meta{
    display:flex;
    flex-wrap:wrap;
    gap:6px 10px;
    margin-bottom:10px;
    font-size:13px;
    color:#475569 !important;
}

.ri-badges{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin:10px 0;
}

.ri-badge{
    display:inline-flex;
    align-items:center;
    border-radius:999px;
    padding:5px 10px;
    font-size:12px;
    font-weight:900;
    border:1px solid #cbd5e1;
    background:#f8fafc;
    color:#0f172a !important;
}

.ri-badge-scopus{
    background:#fff7ed;
    border-color:#fdba74;
}

.ri-badge-wos{
    background:#eff6ff;
    border-color:#93c5fd;
}

.ri-badge-crossref{
    background:#f0fdf4;
    border-color:#86efac;
}

.ri-links{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:11px;
}

.ri-links a{
    display:inline-flex;
    align-items:center;
    border:1px solid #0f172a;
    border-radius:999px;
    padding:7px 12px;
    color:#0f172a !important;
    background:#fff;
    text-decoration:none;
    font-size:12px;
    font-weight:900;
}

.ri-links a:hover{
    background:#0f172a;
    color:#fff !important;
}

/* BEGIN OPAC UNIFIED METRIC CSS V2 */

.ri-metric-panel{
    display:grid;
    grid-template-columns:
        repeat(3, minmax(150px, 1fr));
    gap:12px;
    margin-top:14px;
    padding:14px;
    border:1px solid #dbe3ec;
    border-radius:12px;
    background:#f8fafc;
}

.ri-metric-box{
    min-width:0;
    min-height:72px;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:flex-start;
    gap:8px;
    padding:10px;
    border:1px solid #e2e8f0;
    border-radius:10px;
    background:#ffffff;
}

.ri-metric-title{
    display:block;
    font-size:11px;
    line-height:1.3;
    font-weight:900;
    letter-spacing:.04em;
    text-transform:uppercase;
    color:#64748b !important;
}

.ri-metric-box .altmetric-embed,
.ri-metric-box .__dimensions_badge_embed__,
.ri-metric-box .plumx-plum-print-popup{
    display:inline-block;
    max-width:100%;
}

.ri-plumx-widget{
    font-size:13px;
    font-weight:800;
    color:#0f172a !important;
    text-decoration:none;
}

.ri-plumx-widget:hover{
    text-decoration:underline;
}

@media(max-width:720px){
    .ri-metric-panel{
        grid-template-columns:1fr;
    }
}

/* END OPAC UNIFIED METRIC CSS V2 */


/* BEGIN OPAC UNIFIED METRIC CSS V3 */

/*
 * Clean borderless metrics row.
 * The individual Altmetric, Dimensions and PlumX widgets remain clickable.
 */
.ri-metric-panel{
    display:flex !important;
    align-items:flex-end !important;
    justify-content:flex-start !important;
    flex-wrap:wrap !important;
    gap:30px !important;

    margin:16px 0 8px 0 !important;
    padding:0 !important;

    border:0 !important;
    border-radius:0 !important;
    box-shadow:none !important;
    background:transparent !important;
}

.ri-metric-box{
    display:flex !important;
    flex-direction:column !important;
    align-items:flex-start !important;
    justify-content:flex-start !important;

    width:auto !important;
    min-width:115px !important;
    min-height:0 !important;

    margin:0 !important;
    padding:0 !important;

    border:0 !important;
    border-radius:0 !important;
    box-shadow:none !important;
    background:transparent !important;
}

.ri-metric-title{
    display:block !important;
    margin:0 0 8px 0 !important;
    padding:0 !important;

    font-size:12px !important;
    line-height:1.25 !important;
    font-weight:800 !important;
    letter-spacing:.035em !important;
    text-transform:uppercase !important;
    color:#526985 !important;
}

/*
 * Prevent older profile CSS from stretching or boxing the embeds.
 */
.ri-metric-box .altmetric-embed,
.ri-metric-box .__dimensions_badge_embed__,
.ri-metric-box .dimensions_badge,
.ri-metric-box .plumx-plum-print-popup{
    display:inline-block !important;
    width:auto !important;
    min-width:0 !important;
    max-width:none !important;
    min-height:0 !important;

    margin:0 !important;
    padding:0 !important;

    border:0 !important;
    border-radius:0 !important;
    box-shadow:none !important;
    background:transparent !important;
    overflow:visible !important;
}

/*
 * Reset nested Dimensions elements that were affected by older generic CSS.
 */
.ri-metric-box .__dimensions_badge_embed__ *,
.ri-metric-box .dimensions_badge *{
    box-sizing:border-box;
    max-width:none !important;
}

/*
 * Keep external widget images at their natural proportions.
 */
.ri-metric-box img,
.ri-metric-box svg,
.ri-metric-box iframe{
    max-width:none !important;
    height:auto;
    border:0 !important;
    box-shadow:none !important;
}

/*
 * PlumX must show its real widget icon rather than styled link text.
 */
.ri-plumx-widget{
    display:inline-block !important;
    width:auto !important;
    height:auto !important;

    font-size:0 !important;
    line-height:0 !important;
    text-decoration:none !important;
    color:inherit !important;
}

/*
 * Hide text fallback only after PlumX script has produced the icon.
 */
.ri-plumx-widget img,
.ri-plumx-widget svg{
    display:block !important;
}

/*
 * Compact mobile layout.
 */
@media(max-width:720px){
    .ri-metric-panel{
        gap:22px !important;
    }

    .ri-metric-box{
        min-width:105px !important;
    }
}

/* END OPAC UNIFIED METRIC CSS V3 */



.ri-pagination{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    gap:8px;
    margin-top:20px;
}

.ri-pagination button{
    border:1px solid #0f172a;
    background:#fff;
    color:#0f172a;
    border-radius:999px;
    padding:8px 14px;
    font-weight:900;
    cursor:pointer;
}

.ri-pagination button:disabled{
    opacity:.4;
    cursor:not-allowed;
}

.ri-empty{
    padding:18px;
    border-radius:12px;
    background:#fef3c7;
    color:#92400e !important;
    font-weight:800;
}

.ri-hidden{
    display:none !important;
}

@media(max-width:900px){
    .ri-kpis{
        grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .ri-tools{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){
    .ri-kpis,
    .ri-tools{
        grid-template-columns:1fr;
    }

    .ri-unified-card{
        padding:17px;
    }

    .ri-heading{
        font-size:23px;
    }
}

/* BEGIN OPAC RESEARCH DASHBOARD V4 CSS */

.pub-master-controls,
.pub-section-inline-controls,
.pub-toggle-toolbar,
.pub-section-controls{
    display:none !important;
}

.ri-heading-row-v4{
    margin-bottom:22px !important;
}

.ri-heading-row-v4 .ri-heading{
    margin:0 !important;
}

.ri-kpis-v4{
    position:relative;
    overflow:visible !important;
}

.ri-kpi-v4{
    appearance:none;
    position:relative;
    display:flex !important;
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;

    min-height:145px;
    padding:20px !important;

    color:#062552 !important;
    text-align:left;

    border:1px solid #d8e2ef !important;
    border-radius:18px !important;
    background:#f7faff !important;
    box-shadow:none !important;

    cursor:pointer;
    overflow:hidden;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease,
        background .18s ease;
}

.ri-kpi-v4::after{
    content:"";
    position:absolute;
    right:-30px;
    bottom:-35px;

    width:105px;
    height:105px;

    border-radius:50%;
    background:rgba(6,37,82,.045);
    pointer-events:none;
}

.ri-kpi-v4:hover,
.ri-kpi-v4:focus-visible{
    z-index:4;
    transform:translateY(-4px);

    border-color:#96b5dd !important;
    background:#fff !important;

    box-shadow:
        0 16px 38px rgba(15,23,42,.14) !important;

    outline:none;
}

.ri-kpi-icon{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    width:34px;
    height:34px;
    margin-bottom:12px;

    border-radius:10px;

    color:#fff !important;
    background:#062552;

    font-size:15px;
    line-height:1;
    font-weight:900;
}

.ri-kpi-scopus .ri-kpi-icon{
    background:#f28c28;
}

.ri-kpi-wos .ri-kpi-icon{
    background:#2b74d6;
}

.ri-kpi-crossref .ri-kpi-icon{
    background:#19a862;
}

.ri-kpi-citations .ri-kpi-icon{
    background:#7246b6;
}

.ri-kpi-v4 .ri-kpi-value{
    position:relative;
    z-index:1;

    margin:0 0 3px !important;

    color:#062552 !important;
    font-size:38px !important;
    line-height:1 !important;
    font-weight:950 !important;
}

.ri-kpi-v4 .ri-kpi-label{
    position:relative;
    z-index:1;

    color:#455d79 !important;
    font-size:15px !important;
    line-height:1.3 !important;
    font-weight:850 !important;
}

.ri-kpi-hint{
    position:relative;
    z-index:1;

    display:block;
    margin-top:8px;

    color:#7a8ca3 !important;
    font-size:11px;
    font-weight:700;
}

.ri-kpi-popover{
    position:fixed;
    z-index:10050;

    width:min(340px, calc(100vw - 30px));
    padding:0;

    border:1px solid #cbd8e8;
    border-radius:14px;
    background:#fff;

    box-shadow:
        0 20px 50px rgba(15,23,42,.22);

    opacity:0;
    visibility:hidden;
    transform:translateY(8px);
    pointer-events:none;

    transition:
        opacity .14s ease,
        visibility .14s ease,
        transform .14s ease;
}

.ri-kpi-popover.is-visible{
    opacity:1;
    visibility:visible;
    transform:translateY(0);
}

.ri-kpi-popover-title{
    padding:15px 17px 11px;

    color:#062552 !important;
    border-bottom:1px solid #e4eaf2;

    font-size:16px;
    line-height:1.3;
    font-weight:900;
}

.ri-kpi-popover-body{
    padding:13px 17px 16px;
}

.ri-kpi-detail-grid{
    display:grid;
    gap:0;
}

.ri-kpi-detail-row{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:18px;

    padding:8px 0;
    border-bottom:1px solid #edf1f6;
}

.ri-kpi-detail-row:last-child{
    border-bottom:0;
}

.ri-kpi-detail-label{
    color:#526985 !important;
    font-size:13px;
    line-height:1.4;
    font-weight:700;
}

.ri-kpi-detail-value{
    color:#061f46 !important;
    font-size:13px;
    line-height:1.4;
    font-weight:900;
    text-align:right;
}

.ri-kpi-detail-title{
    max-width:200px;
    word-break:break-word;
}

.ri-kpi-modal{
    position:fixed;
    inset:0;
    z-index:11000;

    display:none;
    align-items:center;
    justify-content:center;

    padding:20px;
}

.ri-kpi-modal.is-open{
    display:flex;
}

.ri-kpi-modal-backdrop{
    position:absolute;
    inset:0;
    background:rgba(4,17,38,.62);
    backdrop-filter:blur(2px);
}

.ri-kpi-modal-dialog{
    position:relative;
    z-index:1;

    width:min(620px, 100%);
    max-height:min(760px, calc(100vh - 40px));
    overflow:auto;

    border-radius:18px;
    background:#fff;

    box-shadow:
        0 28px 75px rgba(0,0,0,.32);
}

.ri-kpi-modal-header{
    position:sticky;
    top:0;
    z-index:2;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;

    padding:20px 22px;

    border-bottom:1px solid #e3eaf3;
    background:#fff;
}

.ri-kpi-modal-header h3{
    margin:0 !important;

    color:#062552 !important;
    font-size:22px;
    line-height:1.25;
    font-weight:950;
}

.ri-kpi-modal-close{
    appearance:none;

    width:40px;
    height:40px;

    border:1px solid #ccd8e7 !important;
    border-radius:50% !important;
    background:#f7faff !important;
    color:#062552 !important;

    font-size:27px;
    line-height:1;
    font-weight:500;
    cursor:pointer;
}

.ri-kpi-modal-close:hover,
.ri-kpi-modal-close:focus-visible{
    background:#e9f1fc !important;
    outline:none;
}

.ri-kpi-modal-body{
    padding:20px 22px 24px;
}

body.ri-modal-open{
    overflow:hidden;
}

@media(max-width:900px){
    .ri-kpi-v4{
        min-height:132px;
    }
}

@media(max-width:600px){
    .ri-kpi-hint{
        display:none;
    }

    .ri-kpi-v4{
        min-height:110px;
    }

    .ri-kpi-v4 .ri-kpi-value{
        font-size:32px !important;
    }

    .ri-kpi-modal{
        padding:10px;
    }

    .ri-kpi-modal-dialog{
        max-height:calc(100vh - 20px);
    }
}

/* END OPAC RESEARCH DASHBOARD V4 CSS */


/* BEGIN OPAC RESEARCH DASHBOARD V6 CSS */

.ri-source-metrics{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin:14px 0 10px;
}

.ri-source-metric{
    display:inline-flex;
    align-items:center;
    gap:11px;

    min-width:190px;
    min-height:68px;
    padding:10px 13px;

    border:1px solid #dce4ee;
    border-radius:10px;
    background:#fff;

    box-shadow:
        0 2px 8px rgba(15,23,42,.06);

    transition:
        transform .16s ease,
        box-shadow .16s ease,
        border-color .16s ease;
}

.ri-source-metric:hover{
    transform:translateY(-2px);
    border-color:#afc1d8;

    box-shadow:
        0 8px 20px rgba(15,23,42,.12);
}

.ri-source-metric-icon{
    flex:0 0 auto;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    width:45px;
    height:45px;

    border-radius:9px;

    color:#fff;
    font-size:18px;
    line-height:1;
    font-weight:900;
}

.ri-source-metric-scopus .ri-source-metric-icon{
    background:#f28c28;
}

.ri-source-metric-wos .ri-source-metric-icon{
    background:#2264a7;
}

.ri-source-metric-content{
    display:flex;
    flex-direction:column;
    min-width:0;
    line-height:1.15;
}

.ri-source-metric-count{
    color:#111827;

    font-size:24px;
    line-height:1;
    font-weight:850;
}

.ri-source-metric-label{
    margin-top:6px;

    color:#4b5563;

    font-size:11px;
    line-height:1.25;
    font-weight:800;
    letter-spacing:.025em;
    text-transform:uppercase;
}

.ri-crossref-symbol{
    display:flex;
    flex-direction:column;
    gap:3px;

    padding:8px;

    border:1px solid #dfe4ea;
    background:#f8fafc;
}

.ri-crossref-symbol i{
    display:block;

    width:27px;
    height:7px;

    transform:skewY(-13deg);
}

.ri-crossref-symbol i:nth-child(1){
    background:#f5c400;
}

.ri-crossref-symbol i:nth-child(2){
    background:#ed6a2c;
}

.ri-crossref-symbol i:nth-child(3){
    background:#cf2533;
}

@media(max-width:650px){
    .ri-source-metrics{
        display:grid;
        grid-template-columns:1fr;
    }

    .ri-source-metric{
        width:100%;
        min-width:0;
    }
}

/* END OPAC RESEARCH DASHBOARD V6 CSS */

</style>

[% IF has_profile %]
<div class="ri-unified-shell">
    <section class="ri-unified-card" id="research-intelligence-publications">

        
        <div class="ri-heading-row ri-heading-row-v4">
            <h2 class="ri-heading">
                Research Publications
            </h2>
        </div>


        
        <div
            class="ri-kpis ri-kpis-v4"
            id="ri-kpi-dashboard"
            aria-label="Research publication summary"
        >
            <button
                type="button"
                class="ri-kpi ri-kpi-v4"
                data-kpi="unique"
                aria-haspopup="dialog"
            >
                <span class="ri-kpi-icon" aria-hidden="true">◆</span>

                <span class="ri-kpi-value">
                    [% unified_summary.total_publications | html %]
                </span>

                <span class="ri-kpi-label">
                    Publications
                </span>

                <span class="ri-kpi-hint">
                    Hover or click for details
                </span>
            </button>

            <button
                type="button"
                class="ri-kpi ri-kpi-v4 ri-kpi-scopus"
                data-kpi="scopus"
                aria-haspopup="dialog"
            >
                <span class="ri-kpi-icon" aria-hidden="true">S</span>

                <span class="ri-kpi-value">
                    [% unified_summary.scopus_publications | html %]
                </span>

                <span class="ri-kpi-label">
                    Scopus
                </span>

                <span class="ri-kpi-hint">
                    Hover or click for details
                </span>
            </button>

            <button
                type="button"
                class="ri-kpi ri-kpi-v4 ri-kpi-wos"
                data-kpi="wos"
                aria-haspopup="dialog"
            >
                <span class="ri-kpi-icon" aria-hidden="true">W</span>

                <span class="ri-kpi-value">
                    [% unified_summary.wos_publications | html %]
                </span>

                <span class="ri-kpi-label">
                    Web of Science
                </span>

                <span class="ri-kpi-hint">
                    Hover or click for details
                </span>
            </button>

            <button
                type="button"
                class="ri-kpi ri-kpi-v4 ri-kpi-crossref"
                data-kpi="crossref"
                aria-haspopup="dialog"
            >
                <span class="ri-kpi-icon" aria-hidden="true">C</span>

                <span class="ri-kpi-value">
                    [% unified_summary.crossref_publications | html %]
                </span>

                <span class="ri-kpi-label">
                    Crossref
                </span>

                <span class="ri-kpi-hint">
                    Hover or click for details
                </span>
            </button>

            <button
                type="button"
                class="ri-kpi ri-kpi-v4 ri-kpi-citations"
                data-kpi="citations"
                aria-haspopup="dialog"
            >
                <span class="ri-kpi-icon" aria-hidden="true">↗</span>

                <span class="ri-kpi-value">
                    [% unified_summary.total_citations | html %]
                </span>

                <span class="ri-kpi-label">
                    Citations
                </span>

                <span class="ri-kpi-hint">
                    Hover or click for details
                </span>
            </button>
        </div>

        <div
            class="ri-kpi-popover"
            id="ri-kpi-popover"
            role="tooltip"
            aria-hidden="true"
        >
            <div class="ri-kpi-popover-title"></div>
            <div class="ri-kpi-popover-body"></div>
        </div>

        <!-- BEGIN OPAC RESEARCH DASHBOARD V4 MODAL -->
        <div
            class="ri-kpi-modal"
            id="ri-kpi-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="ri-kpi-modal-title"
            aria-hidden="true"
        >
            <div
                class="ri-kpi-modal-backdrop"
                data-ri-modal-close="1"
            ></div>

            <div class="ri-kpi-modal-dialog">
                <div class="ri-kpi-modal-header">
                    <h3 id="ri-kpi-modal-title">
                        Publication Details
                    </h3>

                    <button
                        type="button"
                        class="ri-kpi-modal-close"
                        data-ri-modal-close="1"
                        aria-label="Close publication details"
                    >
                        ×
                    </button>
                </div>

                <div
                    class="ri-kpi-modal-body"
                    id="ri-kpi-modal-body"
                ></div>
            </div>
        </div>
        <!-- END OPAC RESEARCH DASHBOARD V4 MODAL -->

<div class="ri-tools">
            <input
                type="search"
                id="ri-publication-search"
                placeholder="Search title, journal, DOI or document type"
                aria-label="Search publications"
            >

            <select id="ri-year-filter" aria-label="Filter by year">
                <option value="">All years</option>
            </select>

            <select
                id="ri-source-filter"
                aria-label="Filter publications by source combination"
            >
                <option value="">All publications</option>

                <optgroup label="Indexed or verified in">
                    <option value="scopus">
                        Any Scopus publication
                    </option>

                    <option value="wos">
                        Any Web of Science publication
                    </option>

                    <option value="crossref">
                        Crossref verified
                    </option>
                </optgroup>

                <optgroup label="Source combinations">
                    <option value="scopus-wos-crossref">
                        Scopus + WoS + Crossref
                    </option>

                    <option value="scopus-wos-any-crossref">
                        Scopus + WoS
                    </option>

                    <option value="scopus-crossref-not-wos">
                        Scopus + Crossref, not WoS
                    </option>

                    <option value="wos-crossref-not-scopus">
                        WoS + Crossref, not Scopus
                    </option>
                </optgroup>

                <optgroup label="Source comparison">
                    <option value="scopus-not-wos">
                        Scopus, not WoS
                    </option>

                    <option value="wos-not-scopus">
                        WoS, not Scopus
                    </option>

                    <option value="only-scopus">
                        Scopus Exclusive (not in WoS/Crossref)
                    </option>

                    <option value="only-wos">
                        WoS Exclusive (not in Scopus/Crossref)
                    </option>

                    <option value="only-crossref">
                        Crossref Exclusive
                    </option>
                </optgroup>
            </select>

            <select id="ri-page-size" aria-label="Publications per page">
                <option value="10">10 per page</option>
                <option value="25" selected>25 per page</option>
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>
            </select>
        </div>

        <div class="ri-result-note" id="ri-result-note"></div>

        [% IF unified_publication_count %]
            <div class="ri-publication-list" id="ri-publication-list">

                [% FOREACH publication IN unified_publications %]
                    <article
                        class="ri-publication"
                        data-year="[% publication.publication_year | html %]"
                        data-scopus="[% publication.has_scopus | html %]"
                        data-wos="[% publication.has_wos | html %]"
                        data-crossref="[% publication.has_crossref | html %]"
                        data-search="[% publication.search_text | html %]"
                        data-title="[% publication.title | html %]"
                        data-type="[% publication.document_type | html %]"
                        data-best-citations="[% publication.best_citation_count | html %]"
                        data-scopus-citations="[% publication.scopus_citations | html %]"
                        data-wos-citations="[% publication.wos_citations | html %]"
                        data-crossref-citations="[% publication.crossref_citations | html %]"
                    >
                        <h3 class="ri-publication-title">
                            [% publication.title | html %]
                        </h3>

                        <div class="ri-meta">
                            [% IF publication.journal %]
                                <span>
                                    <strong>Journal:</strong>
                                    [% publication.journal | html %]
                                </span>
                            [% END %]

                            [% IF publication.publication_year %]
                                <span>
                                    <strong>Year:</strong>
                                    [% publication.publication_year | html %]
                                </span>
                            [% END %]

                            [% IF publication.document_type %]
                                <span>
                                    <strong>Type:</strong>
                                    [% publication.document_type | html %]
                                </span>
                            [% END %]

                            [% IF publication.best_citation_count %]
                                <span>
                                    <strong>Citations:</strong>
                                    [% publication.best_citation_count | html %]
                                </span>
                            [% END %]

                            [% IF publication.author_position %]
                                <span>
                                    <strong>Author position:</strong>
                                    [% publication.author_position | html %]
                                </span>
                            [% END %]
                        </div>

                        <div class="ri-badges">
                            [% IF publication.has_scopus %]
                                <span class="ri-badge ri-badge-scopus">
                                    Scopus
                                    [% IF publication.scopus_citations %]
                                        · [% publication.scopus_citations | html %] citations
                                    [% END %]
                                </span>
                            [% END %]

                            [% IF publication.has_wos %]
                                <span class="ri-badge ri-badge-wos">
                                    Web of Science
                                    [% IF publication.wos_citations %]
                                        · [% publication.wos_citations | html %] citations
                                    [% END %]
                                </span>
                            [% END %]

                            [% IF publication.has_crossref %]
                                <span class="ri-badge ri-badge-crossref">
                                    Crossref Verified
                                    [% IF publication.crossref_citations %]
                                        · [% publication.crossref_citations | html %] citations
                                    [% END %]
                                </span>
                            [% END %]
                        </div>

                        <!-- BEGIN OPAC SOURCE AUTHOR NAMES V7 -->
                        
                        <!-- Repeated publication-level author
                             names removed. Profile display names
                             are shown once above. -->

                        <!-- END OPAC SOURCE AUTHOR NAMES V7 -->

                        <!-- BEGIN OPAC RESEARCH DASHBOARD V6 SOURCE METRICS -->
                        <div
                            class="ri-source-metrics"
                            aria-label="Citation counts reported by individual sources"
                        >
                            [% IF publication.has_scopus %]
                                <div
                                    class="ri-source-metric ri-source-metric-scopus"
                                    title="Citation count reported by Scopus"
                                >
                                    <span
                                        class="ri-source-metric-icon"
                                        aria-hidden="true"
                                    >
                                        S
                                    </span>

                                    <span class="ri-source-metric-content">
                                        <span class="ri-source-metric-count">
                                            [% IF publication.scopus_citations %]
                                                [% publication.scopus_citations | html %]
                                            [% ELSE %]
                                                0
                                            [% END %]
                                        </span>

                                        <span class="ri-source-metric-label">
                                            Scopus citations
                                        </span>
                                    </span>
                                </div>
                            [% END %]

                            [% IF publication.has_wos %]
                                <div
                                    class="ri-source-metric ri-source-metric-wos"
                                    title="Citation count reported by Web of Science"
                                >
                                    <span
                                        class="ri-source-metric-icon"
                                        aria-hidden="true"
                                    >
                                        W
                                    </span>

                                    <span class="ri-source-metric-content">
                                        <span class="ri-source-metric-count">
                                            [% IF publication.wos_citations %]
                                                [% publication.wos_citations | html %]
                                            [% ELSE %]
                                                0
                                            [% END %]
                                        </span>

                                        <span class="ri-source-metric-label">
                                            Web of Science citations
                                        </span>
                                    </span>
                                </div>
                            [% END %]

                            [% IF publication.has_crossref %]
                                <div
                                    class="ri-source-metric ri-source-metric-crossref"
                                    title="Crossref is-referenced-by-count for this DOI"
                                >
                                    <span
                                        class="ri-source-metric-icon ri-crossref-symbol"
                                        aria-hidden="true"
                                    >
                                        <i></i>
                                        <i></i>
                                        <i></i>
                                    </span>

                                    <span class="ri-source-metric-content">
                                        <span class="ri-source-metric-count">
                                            [% IF publication.crossref_citations %]
                                                [% publication.crossref_citations | html %]
                                            [% ELSE %]
                                                0
                                            [% END %]
                                        </span>

                                        <span class="ri-source-metric-label">
                                            Cited by in Crossref
                                        </span>
                                    </span>
                                </div>
                            [% END %]
                        </div>
                        <!-- END OPAC RESEARCH DASHBOARD V6 SOURCE METRICS -->

                        [% IF publication.doi %]
                            <div class="ri-meta">
                                <span>
                                    <strong>DOI:</strong>
                                    [% publication.doi | html %]
                                </span>
                            </div>
                        [% END %]

                        <!-- BEGIN OPAC UNIFIED METRIC MARKUP V2 -->
                        [% IF publication.doi %]
                            <div
                                class="ri-metric-panel"
                                aria-label="Research impact metrics"
                            >
                                <div class="ri-metric-box">
                                    <span class="ri-metric-title">
                                        Altmetric Attention
                                    </span>

                                    <div
                                        class="altmetric-embed"
                                        data-badge-type="donut"
                                        data-badge-popover="right"
                                        data-link-target="_blank"
                                        data-hide-no-mentions="false"
                                        data-doi="[% publication.doi | html %]"
                                    ></div>
                                </div>

                                <div class="ri-metric-box">
                                    <span class="ri-metric-title">
                                        Dimensions Citations
                                    </span>

                                    <span
                                        class="__dimensions_badge_embed__"
                                        data-doi="[% publication.doi | html %]"
                                        data-style="small_circle"
                                        data-legend="always"
                                        data-hide-zero-citations="false"
                                    ></span>
                                </div>

                                <div class="ri-metric-box">
                                    <span class="ri-metric-title">
                                        PlumX Metrics
                                    </span>

                                    <a href="https://plu.mx/plum/a/?doi=[% publication.doi | html %]" class="plumx-plum-print-popup pub-plumx-widget" data-popup="right" data-size="large" data-hide-when-empty="false" data-detail-same-page="false" target="_blank" rel="noopener noreferrer"></a>
                                </div>
                            </div>
                        [% END %]
                        <!-- END OPAC UNIFIED METRIC MARKUP V2 -->


                        <div class="ri-links">
                            [% IF publication.doi_url %]
                                <a
                                    href="[% publication.doi_url | html %]"
                                    target="_blank"
                                    rel="noopener"
                                >
                                    View DOI
                                </a>
                            [% END %]

                            [% IF publication.scopus_url %]
                                <a
                                    href="[% publication.scopus_url | html %]"
                                    target="_blank"
                                    rel="noopener"
                                >
                                    View Scopus
                                </a>
                            [% END %]

                            [% IF publication.wos_url %]
                                <a
                                    href="[% publication.wos_url | html %]"
                                    target="_blank"
                                    rel="noopener"
                                >
                                    View Web of Science
                                </a>
                            [% END %]

                            [% IF publication.crossref_url %]
                                <a
                                    href="[% publication.crossref_url | html %]"
                                    target="_blank"
                                    rel="noopener"
                                >
                                    View Crossref
                                </a>
                            [% END %]
                        </div>
                    </article>
                [% END %]
            </div>

            <div class="ri-empty ri-hidden" id="ri-filter-empty">
                No publications match the selected filters.
            </div>

            <div class="ri-pagination">
                <button type="button" id="ri-prev-page">
                    Previous
                </button>

                <span id="ri-page-status"></span>

                <button type="button" id="ri-next-page">
                    Next
                </button>
            </div>

        [% ELSE %]
            <div class="ri-empty">
                No confirmed publication records are currently available.
            </div>
        [% END %]
    </section>
</div>
[% END %]

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    /*
     * Hide the older source-wise publication sections.
     * The data remains untouched in the database and CGI.
     */
    document.querySelectorAll('.pub-card.full').forEach(function (section) {
        var heading = section.querySelector('h2');

        if (!heading) {
            return;
        }

        var title = (heading.textContent || '').trim();

        if (
            title.indexOf('Crossref Verified Publications') !== -1 ||
            title.indexOf('Scopus Indexed Publications') !== -1 ||
            title.indexOf('Web of Science Indexed Publications') !== -1
        ) {
            section.classList.add('ri-hidden');
        }
    });

    document.querySelectorAll(
        '.pub-master-controls, .pub-toggle-toolbar, .pub-section-controls'
    ).forEach(function (element) {
        element.classList.add('ri-hidden');
    });

    var list = document.getElementById('ri-publication-list');

    if (!list) {
        return;
    }

    var publications = Array.prototype.slice.call(
        list.querySelectorAll('.ri-publication')
    );

    var searchInput = document.getElementById('ri-publication-search');
    var yearFilter = document.getElementById('ri-year-filter');
    var sourceFilter = document.getElementById('ri-source-filter');
    var pageSizeSelect = document.getElementById('ri-page-size');
    var resultNote = document.getElementById('ri-result-note');
    var emptyMessage = document.getElementById('ri-filter-empty');
    var previousButton = document.getElementById('ri-prev-page');
    var nextButton = document.getElementById('ri-next-page');
    var pageStatus = document.getElementById('ri-page-status');

    var currentPage = 1;

    var years = [];

    publications.forEach(function (publication) {
        var year = publication.getAttribute('data-year');

        if (year && years.indexOf(year) === -1) {
            years.push(year);
        }
    });

    years.sort(function (a, b) {
        return Number(b) - Number(a);
    });

    years.forEach(function (year) {
        var option = document.createElement('option');
        option.value = year;
        option.textContent = year;
        yearFilter.appendChild(option);
    });

    function filteredPublications() {
        var query = (searchInput.value || '').toLowerCase().trim();
        var selectedYear = yearFilter.value;
        var selectedSource = sourceFilter.value;

        return publications.filter(function (publication) {
            var searchText =
                (publication.getAttribute('data-search') || '').toLowerCase();

            var publicationYear =
                publication.getAttribute('data-year') || '';

            var queryMatches =
                !query || searchText.indexOf(query) !== -1;

            var yearMatches =
                !selectedYear || publicationYear === selectedYear;

            var hasScopus =
                publication.getAttribute('data-scopus') === '1';

            var hasWos =
                publication.getAttribute('data-wos') === '1';

            var hasCrossref =
                publication.getAttribute('data-crossref') === '1';

            var sourceMatches = true;

            switch (selectedSource) {
                case 'scopus':
                    sourceMatches = hasScopus;
                    break;

                case 'wos':
                    sourceMatches = hasWos;
                    break;

                case 'crossref':
                    sourceMatches = hasCrossref;
                    break;

                case 'scopus-wos-crossref':
                    sourceMatches =
                        hasScopus &&
                        hasWos &&
                        hasCrossref;
                    break;

                case 'scopus-wos-any-crossref':
                    sourceMatches =
                        hasScopus &&
                        hasWos;
                    break;

                case 'scopus-crossref-not-wos':
                    sourceMatches =
                        hasScopus &&
                        hasCrossref &&
                        !hasWos;
                    break;

                case 'wos-crossref-not-scopus':
                    sourceMatches =
                        hasWos &&
                        hasCrossref &&
                        !hasScopus;
                    break;

                case 'scopus-not-wos':
                    sourceMatches =
                        hasScopus &&
                        !hasWos;
                    break;

                case 'wos-not-scopus':
                    sourceMatches =
                        hasWos &&
                        !hasScopus;
                    break;

                case 'only-scopus':
                    sourceMatches =
                        hasScopus &&
                        !hasWos &&
                        !hasCrossref;
                    break;

                case 'only-wos':
                    sourceMatches =
                        hasWos &&
                        !hasScopus &&
                        !hasCrossref;
                    break;

                case 'only-crossref':
                    sourceMatches =
                        hasCrossref &&
                        !hasScopus &&
                        !hasWos;
                    break;
            }

            return queryMatches && yearMatches && sourceMatches;
        });
    }

    function render() {
        var matches = filteredPublications();
        var pageSize = Number(pageSizeSelect.value || 25);
        var totalPages = Math.max(1, Math.ceil(matches.length / pageSize));

        if (currentPage > totalPages) {
            currentPage = totalPages;
        }

        var start = (currentPage - 1) * pageSize;
        var end = start + pageSize;
        var visible = matches.slice(start, end);

        publications.forEach(function (publication) {
            publication.classList.add('ri-hidden');
        });

        visible.forEach(function (publication) {
            publication.classList.remove('ri-hidden');
        });

        emptyMessage.classList.toggle(
            'ri-hidden',
            matches.length !== 0
        );

        resultNote.textContent =
            matches.length +
            ' publication' +
            (matches.length === 1 ? '' : 's') +
            ' found';

        pageStatus.textContent =
            matches.length
            ? 'Page ' + currentPage + ' of ' + totalPages
            : 'No results';

        previousButton.disabled =
            currentPage <= 1 || matches.length === 0;

        nextButton.disabled =
            currentPage >= totalPages || matches.length === 0;
    }

    function resetAndRender() {
        currentPage = 1;
        render();
    }

    searchInput.addEventListener('input', resetAndRender);
    yearFilter.addEventListener('change', resetAndRender);
    sourceFilter.addEventListener('change', resetAndRender);
    pageSizeSelect.addEventListener('change', resetAndRender);

    previousButton.addEventListener('click', function () {
        if (currentPage > 1) {
            currentPage -= 1;
            render();
            document
                .getElementById('research-intelligence-publications')
                .scrollIntoView({behavior: 'smooth'});
        }
    });

    nextButton.addEventListener('click', function () {
        var matches = filteredPublications();
        var pageSize = Number(pageSizeSelect.value || 25);
        var totalPages = Math.max(1, Math.ceil(matches.length / pageSize));

        if (currentPage < totalPages) {
            currentPage += 1;
            render();
            document
                .getElementById('research-intelligence-publications')
                .scrollIntoView({behavior: 'smooth'});
        }
    });

    render();
});
</script>


<!-- BEGIN OPAC UNIFIED METRICS V2 -->

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    var controlLabels = [
        'Publication Controls',
        'Expand Scopus Articles',
        'Collapse Scopus Articles',
        'Expand WOS Articles',
        'Collapse WOS Articles',
        'Expand All Articles',
        'Collapse All Articles'
    ];

    function normalizedText(element) {
        return (element.textContent || '')
            .replace(/\s+/g, ' ')
            .trim();
    }

    /*
     * First attempt: find the smallest parent containing the complete
     * obsolete publication-control block and remove it.
     */
    var candidates = Array.prototype.slice.call(
        document.querySelectorAll(
            'section, article, fieldset, .card, .panel, .well, div'
        )
    );

    candidates.sort(function (first, second) {
        return first.querySelectorAll('*').length -
            second.querySelectorAll('*').length;
    });

    candidates.some(function (container) {
        if (
            container.id === 'research-intelligence-publications' ||
            container.closest('#research-intelligence-publications')
        ) {
            return false;
        }

        var text = normalizedText(container);

        var hasAllControls = controlLabels.every(
            function (label) {
                return text.indexOf(label) !== -1;
            }
        );

        if (
            hasAllControls &&
            text.indexOf('Unified Research Publications') === -1
        ) {
            container.remove();
            return true;
        }

        return false;
    });

    /*
     * Fallback: remove any remaining obsolete heading or button.
     */
    Array.prototype.slice.call(
        document.querySelectorAll(
            'h1, h2, h3, h4, h5, h6, legend, button, a'
        )
    ).forEach(function (element) {
        if (
            element.closest('#research-intelligence-publications')
        ) {
            return;
        }

        if (
            controlLabels.indexOf(normalizedText(element)) !== -1
        ) {
            var parent = element.parentElement;

            element.remove();

            if (
                parent &&
                normalizedText(parent) === ''
            ) {
                parent.remove();
            }
        }
    });

    /*
     * Some metric scripts may already have loaded elsewhere in the
     * original template. Reinitialize them after DOM creation.
     */
    window.setTimeout(function () {
        if (
            typeof window._altmetric_embed_init === 'function'
        ) {
            window._altmetric_embed_init(
                document.getElementById(
                    'research-intelligence-publications'
                )
            );
        }
    }, 500);
});
</script>







<!-- END OPAC UNIFIED METRICS V2 -->



<script
    async
    src="https://embed.altmetric.com/assets/embed.js"
></script>

<script
    async
    charset="utf-8"
    src="https://integration-badge.dimensions.ai/static/ai/badge.js"
></script>









