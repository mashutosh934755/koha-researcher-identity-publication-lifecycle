[% INCLUDE 'doc-head-open.inc' %]
<title>Research Profile</title>
[% BLOCK cssinclude %][% END %]
[% INCLUDE 'doc-head-close.inc' %]

<style>
.pub-wrap{max-width:1150px;margin:25px auto;background:#fff;border-radius:18px;padding:28px;box-shadow:0 14px 38px rgba(15,23,42,.09)}
.pub-top{display:flex;gap:22px;align-items:flex-start;border-bottom:1px solid #e2e8f0;padding-bottom:22px;margin-bottom:22px}
.pub-photo{width:165px;height:165px;border-radius:18px;object-fit:cover;border:1px solid #e2e8f0;background:#f1f5f9}
.pub-no-photo{width:165px;height:165px;border-radius:18px;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#64748b;font-weight:800}
.pub-status-row {
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin:9px 0 12px;
}
.pub-status-badge {
    display:inline-flex;
    align-items:center;
    border-radius:999px;
    padding:5px 11px;
    font-size:12px;
    font-weight:800;
}
.pub-status-verified {
    background:#dcfce7;
    color:#166534;
    border:1px solid #86efac;
}
.pub-status-pending {
    background:#fef9c3;
    color:#854d0e;
    border:1px solid #fde047;
}
.pub-status-active {
    background:#dbeafe;
    color:#1e40af;
    border:1px solid #93c5fd;
}
.pub-status-former,
.pub-status-inactive {
    background:#e2e8f0;
    color:#334155;
    border:1px solid #cbd5e1;
}

.pub-name{font-size:34px;font-weight:900;color:#071b3a;margin:0 0 6px}
.pub-job{font-size:18px;color:#334155;margin-bottom:6px}
.pub-aff{color:#64748b;margin-bottom:14px}
.pub-actions a{display:inline-block;background:#071b3a;color:#fff!important;border-radius:999px;padding:10px 18px;text-decoration:none;font-weight:800;margin-right:8px;margin-bottom:8px}
.pub-actions a.secondary{background:#e2e8f0;color:#0f172a!important}
.pub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.pub-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:15px;padding:18px}
.pub-card.full{grid-column:1/-1}
.pub-card h2{font-size:18px;color:#0f172a;margin:0 0 12px}
.pub-line{margin:8px 0;color:#0f172a}
.pub-label{font-weight:800;color:#475569;display:inline-block;min-width:190px}
.pub-text{white-space:pre-line;line-height:1.6;color:#1e293b}
.pub-alert{background:#fee2e2;color:#991b1b;padding:13px;border-radius:12px;margin-bottom:15px}
.pub-empty{background:#fef3c7;color:#92400e;padding:13px;border-radius:12px;margin-bottom:15px}
.pub-list{display:grid;gap:12px}
.pub-item{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:14px}
.pub-item-title{font-weight:900;color:#071b3a;margin-bottom:5px}
.pub-meta{font-size:13px;color:#64748b;line-height:1.5}
.pub-badge{display:inline-block;background:#e0f2fe;color:#075985;border-radius:999px;padding:4px 9px;font-size:12px;font-weight:800;margin-right:5px}
.pub-link{color:#075985!important;font-weight:800;text-decoration:underline}
@media(max-width:768px){.pub-top{flex-direction:column}.pub-grid{grid-template-columns:1fr}.pub-wrap{margin:12px;padding:18px}.pub-name{font-size:26px}.pub-label{display:block;min-width:0}}

.pub-metrics{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:10px}
.pub-metric-label{font-size:12px;font-weight:900;color:#475569;background:#f1f5f9;border-radius:999px;padding:5px 9px}
.altmetric-embed{display:inline-block;min-width:45px}
.__dimensions_badge_embed__{display:inline-block;min-width:45px}
.pub-count-note{font-size:13px;color:#64748b;font-weight:700;margin-bottom:12px}


/* Final visibility and publication controls */
.pub-wrap, .pub-wrap *{
  color:#000 !important;
}
.pub-actions a,
.pub-toggle-toolbar button,
.pub-section-controls button,
.pub-item-toggle{
  color:#000 !important;
  background:#fff !important;
  border:1px solid #000 !important;
  box-shadow:none !important;
}
.pub-actions a{
  border-radius:999px !important;
}
.pub-link{
  color:#000 !important;
  text-decoration:underline !important;
}
.pub-toggle-toolbar{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin:18px 0;
  padding:14px;
  border:1px solid #000;
  border-radius:12px;
  background:#fff;
}
.pub-toggle-toolbar button,
.pub-section-controls button{
  padding:9px 14px;
  border-radius:999px;
  font-weight:900;
  cursor:pointer;
}
.pub-section-controls{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:10px 0 16px;
}
.pub-item{
  border-color:#000 !important;
}
.pub-item-title{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  cursor:pointer;
}
.pub-item-toggle{
  white-space:nowrap;
  border-radius:999px;
  padding:5px 10px;
  font-size:12px;
  font-weight:900;
  cursor:pointer;
}
.pub-item.is-collapsed .pub-item-details{
  display:none;
}
.pub-item-details{
  margin-top:10px;
}
.pub-metrics{
  border-top:1px solid #000;
  padding-top:10px;
}
.pub-metric-label{
  color:#000 !important;
  background:#fff !important;
  border:1px solid #000;
}
.plumx-plum-print-popup{
  display:inline-block;
  min-width:36px;
  min-height:36px;
}


/* Section-level controls, PlumX size, and black visibility */
.pub-wrap,
.pub-wrap *{
  color:#000 !important;
}

.pub-link,
.pub-item-title a{
  color:#000 !important;
  text-decoration:underline !important;
}

.pub-actions a,
.pub-section-inline-controls button,
.pub-item-toggle{
  color:#000 !important;
  background:#fff !important;
  border:1px solid #000 !important;
  box-shadow:none !important;
}

.pub-publication-section{
  border:1px solid #d7dde5 !important;
}

.pub-section-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  flex-wrap:wrap;
  margin-bottom:12px;
}

.pub-section-header h2{
  margin:0 !important;
}

.pub-section-inline-controls{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.pub-section-inline-controls button{
  border-radius:999px;
  padding:9px 16px;
  font-weight:900;
  cursor:pointer;
  font-size:14px;
}

.pub-item-toggle{
  border-radius:999px;
  padding:5px 12px;
  font-size:12px;
  font-weight:900;
  cursor:pointer;
}

.pub-toggle-toolbar{
  display:none !important;
}

.pub-section-controls{
  display:none !important;
}

.pub-publication-section.section-collapsed > .pub-count-note,
.pub-publication-section.section-collapsed > .pub-list,
.pub-publication-section.section-collapsed > .pub-empty{
  display:none !important;
}

.pub-publication-section.section-collapsed{
  padding-bottom:18px !important;
}

.pub-item{
  border-color:#000 !important;
}

.pub-item-title{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:12px;
  cursor:pointer;
}

.pub-item.is-collapsed .pub-item-details{
  display:none !important;
}

.pub-item-details{
  margin-top:10px;
}

.pub-metrics{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:14px;
  margin-top:12px;
  padding-top:12px;
  border-top:1px solid #000;
  overflow:visible;
}

.pub-metric-label{
  color:#000 !important;
  background:#fff !important;
  border:1px solid #000 !important;
  border-radius:999px !important;
  font-weight:900 !important;
  padding:7px 12px !important;
}

.altmetric-embed{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  min-width:72px !important;
  min-height:58px !important;
}

.__dimensions_badge_embed__{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  min-width:72px !important;
  min-height:58px !important;
}

.plumx-plum-print-popup{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  min-width:95px !important;
  min-height:70px !important;
  transform:scale(1.9);
  transform-origin:left center;
  margin-left:8px !important;
  margin-right:80px !important;
}

.plumx-plum-print-popup img,
.plumx-plum-print-popup svg,
.plumx-plum-print-popup iframe{
  min-width:52px !important;
  min-height:52px !important;
}

@media(max-width:768px){
  .pub-section-header{
    align-items:flex-start;
  }
  .pub-section-inline-controls button{
    padding:8px 12px;
    font-size:13px;
  }
  .plumx-plum-print-popup{
    transform:scale(1.45);
    margin-right:45px !important;
  }
}


/* Final popup-safe metrics and publication controls */
.pub-wrap,
.pub-wrap *{
  color:#000 !important;
}

.pub-link,
.pub-item-title a{
  color:#000 !important;
