<!-- BEGIN OPAC RESEARCH DASHBOARD V4 JS -->

<script>
document.addEventListener('DOMContentLoaded', function () {
    'use strict';

    var dashboard = document.getElementById('ri-kpi-dashboard');
    var publicationList = document.getElementById('ri-publication-list');
    var popover = document.getElementById('ri-kpi-popover');
    var modal = document.getElementById('ri-kpi-modal');
    var modalTitle = document.getElementById('ri-kpi-modal-title');
    var modalBody = document.getElementById('ri-kpi-modal-body');

    if (
        !dashboard ||
        !publicationList ||
        !popover ||
        !modal ||
        !modalTitle ||
        !modalBody
    ) {
        return;
    }

    document.querySelectorAll(
        '.pub-master-controls, .pub-section-inline-controls'
    ).forEach(function (element) {
        element.remove();
    });

    var articles = Array.prototype.slice.call(
        publicationList.querySelectorAll('.ri-publication')
    );

    function flag(article, source) {
        return String(
            article.getAttribute('data-' + source) || ''
        ) === '1';
    }

    function numberValue(article, name) {
        var raw = article.getAttribute('data-' + name);
        var parsed = Number(raw || 0);

        return Number.isFinite(parsed) ? parsed : 0;
    }

    function sourceCount(source) {
        return articles.filter(function (article) {
            return flag(article, source);
        }).length;
    }

    function citationSum(field) {
        return articles.reduce(function (total, article) {
            return total + numberValue(article, field);
        }, 0);
    }

    function sourceCombination(article) {
        return [
            flag(article, 'scopus'),
            flag(article, 'wos'),
            flag(article, 'crossref')
        ].filter(Boolean).length;
    }

    function onlySourceCount(source) {
        return articles.filter(function (article) {
            return (
                flag(article, source) &&
                sourceCombination(article) === 1
            );
        }).length;
    }

    function multiSourceCount() {
        return articles.filter(function (article) {
            return sourceCombination(article) > 1;
        }).length;
    }

    function exactCombinationCount(
        requireScopus,
        requireWos,
        requireCrossref
    ) {
        return articles.filter(function (article) {
            return (
                flag(article, 'scopus') === requireScopus &&
                flag(article, 'wos') === requireWos &&
                flag(article, 'crossref') === requireCrossref
            );
        }).length;
    }

    function typeSummary(source) {
        var counts = {};

        articles.forEach(function (article) {
            if (source && !flag(article, source)) {
                return;
            }

            var type = (
                article.getAttribute('data-type') ||
                'Not specified'
            ).trim();

            if (!type) {
                type = 'Not specified';
            }

            counts[type] = (counts[type] || 0) + 1;
        });

        return Object.keys(counts)
            .sort(function (first, second) {
                if (counts[second] !== counts[first]) {
                    return counts[second] - counts[first];
                }

                return first.localeCompare(second);
            })
            .map(function (type) {
                return {
                    label: type,
                    value: counts[type]
                };
            });
    }

    function highestCited() {
        var result = {
            count: 0,
            title: 'No citation data available'
        };

        articles.forEach(function (article) {
            var count = numberValue(article, 'best-citations');

            if (count > result.count) {
                result.count = count;
                result.title =
                    article.getAttribute('data-title') ||
                    'Untitled publication';
            }
        });

        return result;
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function row(label, value, valueClass) {
        return (
            '<div class="ri-kpi-detail-row">' +
                '<span class="ri-kpi-detail-label">' +
                    escapeHtml(label) +
                '</span>' +
                '<span class="ri-kpi-detail-value ' +
                    escapeHtml(valueClass || '') +
                '">' +
                    escapeHtml(value) +
                '</span>' +
            '</div>'
        );
    }

    function rowsHtml(rows) {
        return (
            '<div class="ri-kpi-detail-grid">' +
                rows.map(function (item) {
                    return row(
                        item.label,
                        item.value,
                        item.valueClass
                    );
                }).join('') +
            '</div>'
        );
    }

    function typeRows(source) {
        var rows = typeSummary(source);

        if (!rows.length) {
            return [{
                label: 'Document types',
                value: 'No records'
            }];
        }

        return rows;
    }

    function detailsFor(kind) {
        var totalPublications = articles.length;
        var scopus = sourceCount('scopus');
        var wos = sourceCount('wos');
        var crossref = sourceCount('crossref');

        var totalBestCitations = citationSum('best-citations');
        var average = totalPublications
            ? (totalBestCitations / totalPublications).toFixed(2)
            : '0.00';

        var highest = highestCited();

        if (kind === 'unique') {
            return {
                title: 'Research Publications',
                rows: [
                    {
                        label: 'Total publications',
                        value: totalPublications
                    },
                    {
                        label: 'Scopus + WoS + Crossref',
                        value: exactCombinationCount(
                            true,
                            true,
                            true
                        )
                    },
                    {
                        label: 'Scopus + WoS, without Crossref',
                        value: exactCombinationCount(
                            true,
                            true,
                            false
                        )
                    },
                    {
                        label: 'Scopus + Crossref, not WoS',
                        value: exactCombinationCount(
                            true,
                            false,
                            true
                        )
                    },
                    {
                        label: 'WoS + Crossref, not Scopus',
                        value: exactCombinationCount(
                            false,
                            true,
                            true
                        )
                    },
                    {
                        label: 'Scopus Exclusive (not in WoS/Crossref)',
                        value: exactCombinationCount(
                            true,
                            false,
                            false
                        )
                    },
                    {
                        label: 'WoS Exclusive (not in Scopus/Crossref)',
                        value: exactCombinationCount(
                            false,
                            true,
                            false
                        )
                    },
                    {
                        label: 'Crossref Exclusive',
                        value: exactCombinationCount(
                            false,
                            false,
                            true
                        )
                    }
                ]
            };
        }

        if (kind === 'scopus') {
            return {
                title: 'Scopus Publications',
                rows: [
                    {
                        label: 'Indexed publications',
                        value: scopus
                    },
                    {
                        label: 'Scopus-only publications',
                        value: onlySourceCount('scopus')
                    },
                    {
                        label: 'Scopus citation total',
                        value: citationSum('scopus-citations')
                    }
                ].concat(typeRows('scopus'))
            };
        }

        if (kind === 'wos') {
            return {
                title: 'Web of Science Publications',
                rows: [
                    {
                        label: 'Indexed publications',
                        value: wos
                    },
                    {
                        label: 'Web of Science-only publications',
                        value: onlySourceCount('wos')
                    },
                    {
                        label: 'Web of Science citation total',
                        value: citationSum('wos-citations')
                    }
                ].concat(typeRows('wos'))
            };
        }

        if (kind === 'crossref') {
            return {
                title: 'Crossref Records',
                rows: [
                    {
                        label: 'Verified DOI records',
                        value: crossref
                    },
                    {
                        label: 'Crossref-only records',
                        value: onlySourceCount('crossref')
                    },
                    {
                        label: 'Crossref citation total',
                        value: citationSum('crossref-citations')
                    }
                ].concat(typeRows('crossref'))
            };
        }

        return {
            title: 'Citation Summary',
            rows: [
                {
                    label: 'Deduplicated citation total',
                    value: totalBestCitations
                },
                {
                    label: 'Average citations per publication',
                    value: average
                },
                {
                    label: 'Highest citation count',
                    value: highest.count
                },
                {
                    label: 'Highest cited publication',
                    value: highest.title,
                    valueClass: 'ri-kpi-detail-title'
                },
                {
                    label: 'Scopus citation total',
                    value: citationSum('scopus-citations')
                },
                {
                    label: 'Web of Science citation total',
                    value: citationSum('wos-citations')
                },
                {
                    label: 'Crossref citation total',
                    value: citationSum('crossref-citations')
                }
            ]
        };
    }

    function positionPopover(card) {
        var cardRect = card.getBoundingClientRect();
        var popoverRect = popover.getBoundingClientRect();

        var left =
            cardRect.left +
            (cardRect.width / 2) -
            (popoverRect.width / 2);

        left = Math.max(
            12,
            Math.min(
                left,
                window.innerWidth - popoverRect.width - 12
            )
        );

        var top = cardRect.bottom + 10;

        if (
            top + popoverRect.height >
            window.innerHeight - 12
        ) {
            top = cardRect.top - popoverRect.height - 10;
        }

        popover.style.left = Math.round(left) + 'px';
        popover.style.top = Math.max(12, Math.round(top)) + 'px';
    }

    function showPopover(card) {
        var details = detailsFor(
            card.getAttribute('data-kpi')
        );

        popover.querySelector(
            '.ri-kpi-popover-title'
        ).textContent = details.title;

        popover.querySelector(
            '.ri-kpi-popover-body'
        ).innerHTML = rowsHtml(details.rows);

        popover.classList.add('is-visible');
        popover.setAttribute('aria-hidden', 'false');

        window.requestAnimationFrame(function () {
            positionPopover(card);
        });
    }

    function hidePopover() {
        popover.classList.remove('is-visible');
        popover.setAttribute('aria-hidden', 'true');
    }

    function openModal(card) {
        var details = detailsFor(
            card.getAttribute('data-kpi')
        );

        hidePopover();

        modalTitle.textContent = details.title;
        modalBody.innerHTML = rowsHtml(details.rows);

        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');

        document.body.classList.add('ri-modal-open');

        var closeButton = modal.querySelector(
            '.ri-kpi-modal-close'
        );

        if (closeButton) {
            closeButton.focus();
        }
    }

    function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('ri-modal-open');
    }

    dashboard.querySelectorAll('.ri-kpi-v4').forEach(
        function (card) {
            card.addEventListener('mouseenter', function () {
                showPopover(card);
            });

            card.addEventListener('mouseleave', hidePopover);

            card.addEventListener('focus', function () {
                showPopover(card);
            });

            card.addEventListener('blur', hidePopover);

            card.addEventListener('click', function () {
                openModal(card);
            });
        }
    );

    modal.querySelectorAll('[data-ri-modal-close]').forEach(
        function (element) {
            element.addEventListener('click', closeModal);
        }
    );

    document.addEventListener('keydown', function (event) {
        if (
            event.key === 'Escape' &&
            modal.classList.contains('is-open')
        ) {
            closeModal();
        }
    });

    window.addEventListener('resize', hidePopover);
    window.addEventListener('scroll', hidePopover, true);
});
</script>

<!-- END OPAC RESEARCH DASHBOARD V4 JS -->

<!-- END OPAC UNIFIED RESEARCH INTELLIGENCE -->


