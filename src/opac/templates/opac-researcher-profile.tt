<!-- final multi section publication controller -->
<script>
(function () {
  var leakPattern = /readers on Mendeley|See more details|Blogged by|Posted by|Referenced by|Picked up by|Reddited by|Mentioned by/i;

  function removeAltmetricLeaks() {
    document.querySelectorAll(
      '.altmetric-popover, .altmetric_badge_popover, .altmetric-details, [id*="altmetric"][id*="popover"], [class*="altmetric"][class*="popover"], [class*="altmetric"][class*="popup"]'
    ).forEach(function(el) {
      el.remove();
    });

    Array.prototype.slice.call(document.body.children).forEach(function(el) {
      if (el.querySelector && el.querySelector('.pub-wrap')) return;
      if (el.closest && el.closest('.pub-wrap')) return;
      var txt = (el.textContent || '').trim();
      if (txt && txt.length < 1200 && leakPattern.test(txt)) {
        el.remove();
      }
    });
  }

  function getSection(type) {
    var found = null;
    document.querySelectorAll('.pub-card.full').forEach(function(section) {
      var h2 = section.querySelector('h2');
      if (!h2) return;
      var title = (h2.textContent || '').trim();

      if (type === 'scopus' && title.indexOf('Scopus Indexed Publications') !== -1) {
        found = section;
      }

      if (type === 'wos' && title.indexOf('Web of Science Indexed Publications') !== -1) {
        found = section;
      }
    });
    return found;
  }

  function prepareItems(section) {
    section.querySelectorAll('.pub-item').forEach(function(item) {
      var title = item.querySelector('.pub-item-title');
      if (!title) return;

      item.querySelectorAll('.pub-item-toggle').forEach(function(btn) {
        btn.remove();
      });

      var details = item.querySelector('.pub-item-details');

      if (!details) {
        details = document.createElement('div');
        details.className = 'pub-item-details';

        while (title.nextSibling) {
          details.appendChild(title.nextSibling);
        }

        item.appendChild(details);
      }

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pub-item-toggle';
      btn.textContent = 'Show details';
      title.appendChild(btn);

      function setOpen(open) {
        item.classList.toggle('is-collapsed', !open);
        btn.textContent = open ? 'Hide details' : 'Show details';
      }

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        setOpen(item.classList.contains('is-collapsed'));
      });

      title.addEventListener('click', function(e) {
        if (e.target.closest('a') || e.target.closest('button')) return;
        setOpen(item.classList.contains('is-collapsed'));
      });

      setOpen(false);
    });
  }

  function openSection(section) {
    if (!section) return;
    section.classList.remove('section-collapsed');
    prepareItems(section);
    section.querySelectorAll('.pub-item').forEach(function(item) {
      item.classList.remove('is-collapsed');
      var btn = item.querySelector('.pub-item-toggle');
      if (btn) btn.textContent = 'Hide details';
    });

    setTimeout(function () {
      if (window.__plumX && window.__plumX.widgets && window.__plumX.widgets.init) {
        window.__plumX.widgets.init();
      }
    }, 200);
  }

  function closeSection(section) {
    if (!section) return;
    prepareItems(section);
    section.querySelectorAll('.pub-item').forEach(function(item) {
      item.classList.add('is-collapsed');
      var btn = item.querySelector('.pub-item-toggle');
      if (btn) btn.textContent = 'Show details';
    });
    section.classList.add('section-collapsed');
  }

  function prepareSectionHeaders() {
    document.querySelectorAll('.pub-toggle-toolbar, .pub-section-controls').forEach(function(el) {
      el.remove();
    });

    document.querySelectorAll('.pub-card.full').forEach(function(section) {
      var h2 = section.querySelector('h2');
      if (!h2) return;

      var title = (h2.textContent || '').trim();
      var type = '';

      if (title.indexOf('Scopus Indexed Publications') !== -1) {
        type = 'scopus';
      } else if (title.indexOf('Web of Science Indexed Publications') !== -1) {
        type = 'wos';
      } else {
        return;
      }

      section.classList.add('pub-publication-section');
      section.setAttribute('data-pub-section', type);

      section.querySelectorAll('.pub-section-inline-controls').forEach(function(oldControls) {
        oldControls.remove();
      });

      var header = h2.closest('.pub-section-header');

      if (!header) {
        header = document.createElement('div');
        header.className = 'pub-section-header';
        section.insertBefore(header, h2);
        header.appendChild(h2);
      }

      var label = type === 'scopus' ? 'Scopus' : 'Web of Science';

      var controls = document.createElement('div');
      controls.className = 'pub-section-inline-controls';
      controls.innerHTML =
        '<button type="button" class="pub-inline-expand">Expand ' + label + '</button>' +
        '<button type="button" class="pub-inline-collapse">Collapse ' + label + '</button>';

      header.appendChild(controls);

      controls.querySelector('.pub-inline-expand').addEventListener('click', function() {
        openSection(section);
      });

      controls.querySelector('.pub-inline-collapse').addEventListener('click', function() {
        closeSection(section);
      });

      prepareItems(section);
      closeSection(section);
    });
  }

  function addMasterControls() {
    /*
     * Disabled by OPAC Research Dashboard V4.
     * Unified publication controls now use search and filters only.
     */
    document.querySelectorAll(
        '.pub-master-controls, .pub-section-inline-controls'
    ).forEach(function (element) {
        element.remove();
    });
    return;

    var wrap = document.querySelector('.pub-wrap');
    if (!wrap) return;

    document.querySelectorAll('.pub-master-controls').forEach(function(el) {
      el.remove();
    });

    var firstPublication = null;
    document.querySelectorAll('.pub-publication-section').forEach(function(section) {
      if (!firstPublication) firstPublication = section;
    });

    if (!firstPublication) return;

    var bar = document.createElement('div');
    bar.className = 'pub-master-controls';
    bar.innerHTML =
      '<strong>Publication Controls</strong>' +
      '<button type="button" data-action="expand-scopus">Expand Scopus Articles</button>' +
      '<button type="button" data-action="collapse-scopus">Collapse Scopus Articles</button>' +
      '<button type="button" data-action="expand-wos">Expand WOS Articles</button>' +
      '<button type="button" data-action="collapse-wos">Collapse WOS Articles</button>' +
      '<button type="button" data-action="expand-all">Expand All Articles</button>' +
      '<button type="button" data-action="collapse-all">Collapse All Articles</button>';

    firstPublication.parentNode.insertBefore(bar, firstPublication);

    bar.addEventListener('click', function(e) {
      var btn = e.target.closest('button');
      if (!btn) return;

      var action = btn.getAttribute('data-action');
      var scopus = getSection('scopus');
      var wos = getSection('wos');

      if (action === 'expand-scopus') openSection(scopus);
      if (action === 'collapse-scopus') closeSection(scopus);
      if (action === 'expand-wos') openSection(wos);
      if (action === 'collapse-wos') closeSection(wos);
      if (action === 'expand-all') {
        openSection(scopus);
        openSection(wos);
      }
      if (action === 'collapse-all') {
        closeSection(scopus);
        closeSection(wos);
      }
    });
  }

  function init() {
    removeAltmetricLeaks();
    prepareSectionHeaders();
    addMasterControls();

    setTimeout(function () {
      if (window.__plumX && window.__plumX.widgets && window.__plumX.widgets.init) {
        window.__plumX.widgets.init();
      }
    }, 300);
  }

  document.addEventListener('DOMContentLoaded', function () {
    init();
    setTimeout(init, 300);
    setTimeout(removeAltmetricLeaks, 800);
  });

  window.addEventListener('load', function () {
    setTimeout(init, 300);
    setTimeout(removeAltmetricLeaks, 1200);
  });

  setInterval(removeAltmetricLeaks, 2000);
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var textReplacements = [
    ['Available records are loaded page by page from the Scopus Author ID.', 'Available records are loaded page by page from the Scopus Author ID.'],
    ['Available records are loaded page by page from the Web of Science ResearcherID / ORCID.', 'Available records are loaded page by page from the Web of Science ResearcherID / ORCID.'],
    ['Scopus data could not be loaded:', 'Scopus data could not be loaded:'],
    ['Web of Science data could not be loaded:', 'Web of Science data could not be loaded:'],
    ['No publication data was found for this Scopus Author ID.', 'No publication data was found for this Scopus Author ID.'],
    ['No Web of Science publication data was found for this ResearcherID / ORCID.', 'No Web of Science publication data was found for this ResearcherID / ORCID.'],
    ['Research profile is not complete yet.', 'Research profile is not complete yet.']
  ];

  function replaceTextNodes(root) {
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
    var node;
    while ((node = walker.nextNode())) {
      var value = node.nodeValue;
      textReplacements.forEach(function(pair) {
        value = value.split(pair[0]).join(pair[1]);
      });
      node.nodeValue = value;
    }
  }

  replaceTextNodes(document.body);

  var wrap = document.querySelector('.pub-wrap');
  if (!wrap) return;

  var publicationSections = [];
  document.querySelectorAll('.pub-card.full').forEach(function(card) {
    var h2 = card.querySelector('h2');
    if (!h2) return;
    var title = (h2.textContent || '').trim();
    if (title.indexOf('Scopus Indexed Publications') !== -1 || title.indexOf('Web of Science Indexed Publications') !== -1) {
      card.classList.add('pub-publication-section');
      publicationSections.push(card);
    }
  });

  if (!publicationSections.length) return;

  var toolbar = document.createElement('div');
  toolbar.className = 'pub-toggle-toolbar';
  toolbar.innerHTML = '<button type="button" id="pubExpandAll">Expand All</button><button type="button" id="pubCollapseAll">Collapse All</button>';
  var firstSection = publicationSections[0];
  firstSection.parentNode.insertBefore(toolbar, firstSection);

  function prepareItem(item) {
    if (item.dataset.prepared === '1') return;
    item.dataset.prepared = '1';

    var title = item.querySelector('.pub-item-title');
    if (!title) return;

    var details = document.createElement('div');
    details.className = 'pub-item-details';

    while (title.nextSibling) {
      details.appendChild(title.nextSibling);
    }
    item.appendChild(details);

    var toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'pub-item-toggle';
    toggle.textContent = 'Show details';
    title.appendChild(toggle);

    function toggleItem(forceOpen) {
      var open = typeof forceOpen === 'boolean' ? forceOpen : item.classList.contains('is-collapsed');
      item.classList.toggle('is-collapsed', !open);
      toggle.textContent = open ? 'Hide details' : 'Show details';
    }

    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleItem();
    });

    title.addEventListener('click', function(e) {
      if (e.target.closest('a') || e.target.closest('button')) return;
      toggleItem();
    });

    toggleItem(false);
  }

  publicationSections.forEach(function(section) {
    if (!section.querySelector('.pub-section-controls')) {
      var controls = document.createElement('div');
      controls.className = 'pub-section-controls';
      controls.innerHTML = '<button type="button" class="pub-section-expand">Expand Section</button><button type="button" class="pub-section-collapse">Collapse Section</button>';

      var note = section.querySelector('.pub-count-note');
      if (note) {
        note.parentNode.insertBefore(controls, note.nextSibling);
      } else {
        var h2 = section.querySelector('h2');
        h2.parentNode.insertBefore(controls, h2.nextSibling);
      }

      controls.querySelector('.pub-section-expand').addEventListener('click', function() {
        section.querySelectorAll('.pub-item').forEach(function(item) {
          var btn = item.querySelector('.pub-item-toggle');
          item.classList.remove('is-collapsed');
          if (btn) btn.textContent = 'Hide details';
        });
      });

      controls.querySelector('.pub-section-collapse').addEventListener('click', function() {
        section.querySelectorAll('.pub-item').forEach(function(item) {
          var btn = item.querySelector('.pub-item-toggle');
          item.classList.add('is-collapsed');
          if (btn) btn.textContent = 'Show details';
        });
      });
    }

    section.querySelectorAll('.pub-item').forEach(prepareItem);
  });

  document.getElementById('pubExpandAll').addEventListener('click', function() {
    document.querySelectorAll('.pub-item').forEach(function(item) {
      var btn = item.querySelector('.pub-item-toggle');
      item.classList.remove('is-collapsed');
      if (btn) btn.textContent = 'Hide details';
    });
  });

  document.getElementById('pubCollapseAll').addEventListener('click', function() {
    document.querySelectorAll('.pub-item').forEach(function(item) {
      var btn = item.querySelector('.pub-item-toggle');
      item.classList.add('is-collapsed');
      if (btn) btn.textContent = 'Show details';
    });
  });

  if (window.__plumX && window.__plumX.widgets && window.__plumX.widgets.init) {
    window.__plumX.widgets.init();
  }
});
</script>



<!-- hide empty Education / Eperson / Group Policy cards -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.pub-card, .final-card').forEach(function(card) {
    var h = card.querySelector('h2');
    if (!h) return;

    var title = (h.textContent || '').trim();
    var body = (card.textContent || '').replace(title, '').trim();

    if (title === 'Education' || title === 'Group Policy') {
      card.remove();
      return;
    }

    if (title === 'Eperson Policy' && body === '') {
      card.remove();
      return;
    }
  });
});
</script>

<!-- hide Education and Group Policy -->

<script>
document.addEventListener('DOMContentLoaded', function () {
  ['Education', 'Group Policy'].forEach(function (title) {
    document.querySelectorAll('h2').forEach(function (h) {
      if ((h.textContent || '').trim() === title) {
        var card = h.closest('.pub-card, .final-card, .research-card, .profile-card');
        if (card) card.remove();
      }
    });
  });
});
</script>
